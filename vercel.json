{
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "/data/:path*"
    },
    {
      "source": "/appointments.json",
      "destination": "/appointments.json"
    },
    {
      "source": "/summary.json",
      "destination": "/summary.json"
    },
    {
      "source": "/((?!data/|appointments.json|summary.json).*)",
      "destination": "/index.html"
    }
  ]
}
